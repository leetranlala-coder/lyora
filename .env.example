# ─────────────────────────────────────────────────────────────────────────────
# LYORA DM agent — copy to .env and fill in. Never commit .env.
# Anything left blank simply disables that integration.
# ─────────────────────────────────────────────────────────────────────────────

# ---- server ----
NODE_ENV=development
PORT=3000
# the public https URL webhooks are sent to (e.g. https://lyora-agent.onrender.com)
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/lyora.db
LOG_LEVEL=info

# ---- safety switches (read these!) ----
# draft = the AI writes replies and waits for you to approve them in the dashboard.
# auto  = the AI may send replies itself when every safeguard passes.
# Leave on draft until you've reviewed a good number of drafts and trust them.
SEND_MODE=draft
# master switch — false stops all AI processing (messages are still recorded)
AGENT_ENABLED=true
# if you reply to someone yourself in the Instagram app, pause the AI for that lead
AUTO_TAKEOVER_ON_HUMAN_REPLY=true

# ---- behaviour ----
BUSINESS_TIMEZONE=Australia/Perth
# how often the periodic safety check runs (unprocessed messages, follow-ups, retries)
MESSAGE_CHECK_INTERVAL_MINUTES=30
# wait this long after her last message before replying (so she can finish typing)
INBOUND_QUIET_PERIOD_SECONDS=60
# below this confidence the AI asks a question or hands over instead of guessing (0-1)
CONFIDENCE_THRESHOLD=0.6
HOT_LEAD_THRESHOLD=51
VERY_HOT_LEAD_THRESHOLD=76
# very hot leads on offers at/above this price (AUD) go to you personally
HIGH_TICKET_THRESHOLD=1000
MAX_AUTOMATED_FOLLOWUPS=2
FOLLOWUP_INTERVAL_HOURS=20
MINIMUM_HOURS_BETWEEN_FOLLOWUPS=18
# Instagram only allows automated messages within 24h of her last message
MESSAGING_WINDOW_HOURS=24
# follow-ups only go out between these local hours
FOLLOWUP_SEND_START_HOUR=9
FOLLOWUP_SEND_END_HOUR=20
# pause between DM bubbles so they arrive naturally and in order
BUBBLE_DELAY_MS=1500

# ---- AI (Anthropic) ----
# without a key the system runs on a simple offline mock (for testing only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — how much thinking per step
ANTHROPIC_EFFORT=medium

# ---- messaging: mock | manychat | meta ----
MESSAGING_PROVIDER=mock
# ManyChat (Settings → API)
MANYCHAT_API_KEY=
# any long random string; ManyChat sends it in the X-Lyora-Secret header
MANYCHAT_WEBHOOK_SECRET=
# Meta / Instagram API (developers.facebook.com → your app)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_BASE_URL=https://graph.instagram.com/v21.0

# ---- payments (fill in the ones you use) ----
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.paypal.com
SQUARE_WEBHOOK_SIGNATURE_KEY=
# must exactly match the notification URL in your Square dashboard
SQUARE_WEBHOOK_URL=
# any long random string; sent as X-Lyora-Secret from Kajabi/Zapier
KAJABI_WEBHOOK_SECRET=

# ---- calls ----
CALENDLY_WEBHOOK_SIGNING_KEY=
# the link the AI may send when a lead wants a call (leave blank = calls go to you)
DEFAULT_BOOKING_URL=

# ---- dashboard / internal ----
ADMIN_USERNAME=lee
# required — the dashboard is disabled without it
ADMIN_PASSWORD=
# set this to run the safety check from an external cron: POST /internal/tick
INTERNAL_TICK_SECRET=
ENABLE_IN_PROCESS_SCHEDULER=true
